# =============================================================================
# CUA-Lark-15 / LarkVision-Tester 环境变量样例
#
# 用法:
#   1. cp .env.example .env
#   2. 把下面占位符改成真实 key
#   3. 进 Python (主仓 / larkvision/) 都会通过 dotenv 自动加载, 无需 export
#
# .env 已加入 .gitignore, 永远不会被提交.
# larkvision/.env 是软链 -> ../.env, 一份实体, 两处可见.
# =============================================================================

# -----------------------------------------------------------------------------
# 阿里云百炼 (DashScope) - qwen3-vl-plus 主模型 (v0.0.3 路线)
# 申请: https://bailian.console.aliyun.com/  ->  API-KEY 管理
# 端点: OpenAI 兼容 https://dashscope.aliyuncs.com/compatible-mode/v1
# -----------------------------------------------------------------------------
OPENAI_API_KEY=sk-your-dashscope-key-here

# 备用别名 (TuriX main.py 也认这个)
# API_KEY=sk-your-dashscope-key-here

# -----------------------------------------------------------------------------
# (可选) 火山方舟豆包 - 备选 fallback
# 申请: https://console.volcengine.com/ark
# -----------------------------------------------------------------------------
# ARK_API_KEY=your-volcengine-ark-key-here
# ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# -----------------------------------------------------------------------------
# 飞书 lark-cli (评测期 Oracle 用, 不影响主路径)
# 安装: npm install -g @larksuite/cli
# 配置: lark-cli config init
# -----------------------------------------------------------------------------
# LARK_CLI_AS=user

# -----------------------------------------------------------------------------
# 日志 / 输出目录
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO
SCREENSHOT_DIR=./screenshots
BENCH_OUTPUT_DIR=./bench/output
