# =============================================================================
# LarkVision-Tester 环境变量样例
# 复制为 .env 并填入真实值，.env 已加入 .gitignore
# =============================================================================

# ---- LLM 主模型选择 (qwen / doubao) -----------------------------------------
# 缺省时按可用 Key 自动选: DASHSCOPE 优先, 其次 ARK
LLM_PROVIDER=qwen

# ---- 阿里云 Qwen (DashScope) - GUI Agent 专项训练 ---------------------------
# 申请地址: https://bailian.console.aliyun.com/
DASHSCOPE_API_KEY=your_dashscope_api_key_here
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 主模型: Qwen3-VL-Plus (GUI Agent 专项)
QWEN_MODEL=qwen3-vl-plus
# 轻量 fallback
QWEN_MODEL_FALLBACK=qwen3-vl-flash

# ---- 火山方舟 (Volcengine Ark) - 豆包 2.0 Pro -------------------------------
# 申请地址: https://console.volcengine.com/ark
ARK_API_KEY=your_ark_api_key_here
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
DOUBAO_MODEL_PRO=doubao-seed-2-0-pro
DOUBAO_MODEL_FALLBACK=doubao-seed-1-6-251015

# ---- 飞书 lark-cli (评测期 Oracle 用，不影响主路径) -------------------------
# 安装: npm install -g @larksuite/cli
# 配置: lark-cli config init
LARK_CLI_AS=user

# ---- 通用 -------------------------------------------------------------------
LOG_LEVEL=INFO
SCREENSHOT_DIR=./screenshots
BENCH_OUTPUT_DIR=./bench/output
