# Lark Island web-agent runner — environment variables.
#
# Copy this file to `.env` (which is .gitignored) and fill in real values.
#
# DashScope key — used by the default `qwen-default` LLM profile.
# Get one at https://bailian.console.aliyun.com/  -> API-KEY 管理.
# (You can copy it from larkvision/.env where it is named OPENAI_API_KEY.)
DASHSCOPE_API_KEY=

# Optional fallback: Volcano Engine Ark (Doubao-1.5-UI-TARS).
# Set this if Qwen3-VL-Plus turns out to be unstable on UI-TARS prompts.
ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# ─── M5 skill profiles ───────────────────────────────────────────────
#
# Skill-specific Chromium user-data-dirs live under
#   ~/Library/Application Support/LarkIsland/web-agent/profiles/
# with one sub-directory per `userDataDirSegment`:
#   - `feishu/`  — shared by feishu_im_send / feishu_calendar_create
#                  / feishu_doc_create. Persists cookies, localStorage,
#                  IndexedDB after a successful QR-scan login.
#   - `generic/` — fallback for prompts that did not match any skill.
#
# First-run note: the first feishu task triggers a visible Chromium
# window for QR-scan login. Subsequent tasks reuse the cached cookies
# and stay headless.
#
# To force a fresh login (e.g. after rotating to a different account),
# delete the relevant profile directory:
#   rm -rf "$HOME/Library/Application Support/LarkIsland/web-agent/profiles/feishu"

# ─── M6 demo notes ─────────────────────────────────────────────────
#
# Default starting URL (used when a generic prompt has no skill match):
#   https://www.google.com
# For mainland China demos where google.com is unreliable, override:
#   LARK_ISLAND_RUNNER_DEFAULT_URL=https://www.bing.com
#
# GUIAgent maxLoopCount default: 30 (was 12 in M5; bumped after M5 task 7.3
# real-world test showed feishu IM tasks need >25 steps to complete).
# Configured in runners/web-agent/src/runner.ts; not env-driven yet.
#
# To run an end-to-end smoke test from the CLI (bypassing the menubar GUI):
#   cd runners/web-agent
#   npx tsx test/observer-client.ts demo-001 "在 google 搜索 UI-TARS 报告前 3 条"
# Requires LarkIslandApp to be running (BridgeServer hosts the socket).
