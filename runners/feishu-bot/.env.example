# M9 Feishu bot bridge — environment variables
#
# Required: name of the lark-cli profile that has authenticated to the
# challenge-account Feishu app (im / event / contact scopes). Created
# via `lark-cli config init --name <profile> ...` + `lark-cli auth
# login --profile <profile> --domain im,event,contact`.
LARK_BOT_PROFILE=challenge

# Optional: comma-separated open_id allowlist. If unset, ALL senders
# are accepted (demo-friendly). Set to lock the bot down.
# LARK_BOT_ALLOWLIST=ou_aaa,ou_bbb,ou_ccc

# Optional override: BridgeServer Unix socket path. Default is
# ~/Library/Application Support/LarkIsland/bridge.sock. Bot bridge
# connects as observer role.
# LARK_ISLAND_SOCKET_PATH=/Users/me/Library/Application Support/LarkIsland/bridge.sock

# Optional: which LLM profile name to pass to runWebAgentTask. Default
# is qwen-default (the only profile shipped in M5).
# LARK_BOT_LLM_PROFILE=qwen-default

# M11: optional plan-LLM endpoint used for splitting composite Feishu
# IM prompts ("create a calendar event AND notify ...") into multi-step
# workflows. If not set, falls back to DASHSCOPE_API_KEY +
# qwen-plus chat model on DashScope's OpenAI-compatible endpoint.
# Override any subset to point at a different chat model / endpoint.
# LARK_BOT_PLAN_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LARK_BOT_PLAN_LLM_API_KEY=sk-xxx
# LARK_BOT_PLAN_LLM_MODEL=qwen-plus
