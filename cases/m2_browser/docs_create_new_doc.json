{
  "id": "m2_browser_docs_create_new_doc_v1",
  "name": "Create a new Feishu Web doc and type body content",
  "product": "docs",
  "goal": "Open Feishu Web Docs (云文档), click New → Docs → New Docs template to spawn a new wiki doc tab, switch to it, and type body content. The new doc URL (/wiki/<token>) is the primary success signal; the title remains 'Untitled document' since wiki rename requires a different UI gesture.",
  "expected": "CUA-Lark M2 Docs Demo",
  "verifications": [
    {
      "id": "browser_url_docs",
      "provider": "observation",
      "metadata": {
        "field": "browser_url",
        "contains": "feishu"
      }
    },
    {
      "id": "browser_screenshot_written",
      "provider": "observation",
      "metadata": {
        "field": "screenshot_path_exists"
      }
    },
    {
      "id": "openapi_auth_status",
      "provider": "lark_cli",
      "command": ["auth", "status"],
      "optional": true,
      "metadata": {
        "purpose": "Probe Feishu OpenAPI access. Optional: a green check signals API-backed verification is ready to layer on this chain; failure surfaces in the run report but does not block."
      }
    }
  ],
  "steps": [
    {
      "id": "open_feishu_web",
      "action": "activate_app",
      "target": "browser",
      "metadata": {
        "manual_login_wait_seconds": 90
      }
    },
    {
      "id": "wait_for_web_boot",
      "action": "wait",
      "target": "feishu web",
      "value": "2"
    },
    {
      "id": "open_docs_space",
      "action": "activate_app",
      "target": "云文档",
      "metadata": {
        "candidate_urls": [
          "/drive/home/",
          "/space/home/",
          "/space/",
          "/wiki/"
        ],
        "expected_url_contains": ["drive", "space", "wiki"],
        "expected_page_contains": ["云文档", "Docs", "新建", "我的空间"]
      }
    },
    {
      "id": "wait_for_docs_page",
      "action": "wait",
      "target": "docs page",
      "value": "3"
    },
    {
      "id": "click_create_new_button",
      "action": "click",
      "target": "New",
      "metadata": {
        "selectors": [
          {"type": "css", "selector": "[data-selector=\"workspace-next-create_new_file\"]"}
        ],
        "x_ratio": 0.385,
        "y_ratio": 0.14
      }
    },
    {
      "id": "wait_for_create_menu",
      "action": "wait",
      "target": "create menu",
      "value": "1.5"
    },
    {
      "id": "click_new_doc_item",
      "action": "click",
      "target": "Docs",
      "metadata": {
        "selectors": [
          {"type": "xpath", "selector": "//*[@role='menuitem' and (normalize-space()='Docs' or normalize-space()='Doc' or normalize-space()='文档')]"},
          {"type": "xpath", "selector": "//li[normalize-space()='Docs' or normalize-space()='文档']"},
          {"type": "xpath", "selector": "//*[normalize-space()='Docs']/ancestor::li[1]"},
          {"type": "xpath", "selector": "//*[normalize-space()='文档']/ancestor::li[1]"},
          {"type": "css", "selector": "[role='menuitem']:has-text('Docs')"}
        ],
        "x_ratio": 0.204,
        "y_ratio": 0.173
      }
    },
    {
      "id": "wait_for_template_modal",
      "action": "wait",
      "target": "template modal",
      "value": "2"
    },
    {
      "id": "click_blank_doc_template",
      "action": "click",
      "target": "New Docs",
      "metadata": {
        "selectors": [
          {"type": "xpath", "selector": "//*[normalize-space()='New Docs' or normalize-space()='空白文档' or normalize-space()='新建文档']"},
          {"type": "xpath", "selector": "//*[contains(@class, 'template')][.//*[normalize-space()='New Docs' or normalize-space()='空白文档']]"}
        ],
        "x_ratio": 0.267,
        "y_ratio": 0.238
      }
    },
    {
      "id": "wait_for_new_doc_tab",
      "action": "wait",
      "target": "new doc tab",
      "value": "4"
    },
    {
      "id": "switch_to_new_doc_tab",
      "action": "activate_app",
      "target": "browser",
      "metadata": {
        "switch_to_latest_tab": true
      }
    },
    {
      "id": "wait_for_doc_editor",
      "action": "wait",
      "target": "doc editor",
      "value": "4"
    },
    {
      "id": "focus_doc_body",
      "action": "click",
      "target": "doc body",
      "metadata": {
        "selectors": [
          {"type": "xpath", "selector": "//div[@contenteditable='true']"}
        ],
        "x_ratio": 0.5,
        "y_ratio": 0.4
      }
    },
    {
      "id": "wait_for_body_focus",
      "action": "wait",
      "target": "body focus",
      "value": "0.6"
    },
    {
      "id": "type_doc_content",
      "action": "type",
      "target": "doc body",
      "value": "CUA-Lark M2 Docs Demo",
      "metadata": {
        "selectors": [
          {"type": "xpath", "selector": "//div[@contenteditable='true']"}
        ],
        "x_ratio": 0.5,
        "y_ratio": 0.4
      }
    }
  ]
}
