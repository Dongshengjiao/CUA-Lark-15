{
  "id": "m2_browser_calendar_open_create_event_window_v1",
  "name": "Open the Feishu Web calendar create-event window",
  "product": "calendar",
  "goal": "Open Feishu Web, switch to Calendar, and launch the create-event window via the floating action button.",
  "expected": "Edit event",
  "verifications": [
    {
      "id": "browser_url_calendar",
      "provider": "observation",
      "metadata": {
        "field": "browser_url",
        "contains": "feishu"
      }
    },
    {
      "id": "browser_screenshot_written",
      "provider": "observation",
      "metadata": {
        "field": "screenshot_path_exists"
      }
    }
  ],
  "steps": [
    {
      "id": "open_feishu_web",
      "action": "activate_app",
      "target": "browser",
      "metadata": {
        "manual_login_wait_seconds": 90
      }
    },
    {
      "id": "wait_for_web_boot",
      "action": "wait",
      "target": "feishu web",
      "value": "2"
    },
    {
      "id": "open_calendar_tab",
      "action": "activate_app",
      "target": "日历",
      "metadata": {
        "candidate_urls": [
          "/calendar/",
          "/suite/calendar/",
          "/calendar/home/"
        ],
        "expected_url_contains": [
          "calendar"
        ],
        "expected_page_contains": [
          "Calendar",
          "创建日程",
          "Create event"
        ]
      }
    },
    {
      "id": "wait_for_calendar_page",
      "action": "wait",
      "target": "calendar page",
      "value": "2"
    },
    {
      "id": "open_create_event_window",
      "action": "click",
      "target": "创建日程",
      "metadata": {
        "selectors": [
          {
            "type": "xpath",
            "selector": "//button[contains(., '创建日程')]"
          },
          {
            "type": "xpath",
            "selector": "//*[contains(text(), '创建日程')]/ancestor::button[1]"
          },
          {
            "type": "xpath",
            "selector": "//button[contains(., 'Create event')]"
          },
          {
            "type": "xpath",
            "selector": "//*[contains(text(), 'Create event')]/ancestor::button[1]"
          },
          {
            "type": "xpath",
            "selector": "//button[@aria-label='Create' or @aria-label='创建']"
          }
        ],
        "x_ratio": 0.974,
        "y_ratio": 0.955
      }
    },
    {
      "id": "wait_for_create_event_modal",
      "action": "wait",
      "target": "create event window",
      "value": "4"
    }
  ]
}
